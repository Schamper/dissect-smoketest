#cloud-config
hostname: dissect-fedora
fqdn: dissect-fedora.smoketest

users:
  - default
  - name: user
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    plain_text_passwd: password

ssh_pwauth: true

package_update: true
package_upgrade: true

write_files:
  - path: /etc/dissect-smoketest/provisioned
    content: |
      template=fedora
      lifecycle=rolling
    permissions: '0644'
