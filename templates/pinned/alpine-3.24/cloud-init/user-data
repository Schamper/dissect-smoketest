#cloud-config
hostname: dissect-alpine-3.24
fqdn: dissect-alpine-3.24.smoketest

users:
  - default
  - name: user
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    plain_text_passwd: password

ssh_pwauth: true

packages:
  - sudo

write_files:
  - path: /etc/dissect-smoketest/provisioned
    content: |
      template=alpine-3.24
      lifecycle=pinned
    permissions: '0644'
