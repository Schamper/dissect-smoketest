#cloud-config
hostname: dissect-rocky-10
fqdn: dissect-rocky-10.smoketest

users:
  - default
  - name: user
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    plain_text_passwd: password

ssh_pwauth: true

write_files:
  - path: /etc/dissect-smoketest/provisioned
    content: |
      template=rocky-10
      lifecycle=pinned
    permissions: '0644'
