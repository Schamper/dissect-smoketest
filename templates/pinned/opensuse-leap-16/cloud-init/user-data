#cloud-config
hostname: dissect-opensuse-leap-16
fqdn: dissect-opensuse-leap-16.smoketest

users:
  - default
  - name: user
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    plain_text_passwd: password

ssh_pwauth: true

write_files:
  - path: /etc/dissect-smoketest/provisioned
    content: |
      template=opensuse-leap-16
      lifecycle=pinned
    permissions: '0644'
