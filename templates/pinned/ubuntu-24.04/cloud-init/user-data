#cloud-config
hostname: dissect-ubuntu-24.04
fqdn: dissect-ubuntu-24.04.smoketest

users:
  - default
  - name: user
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    plain_text_passwd: password

ssh_pwauth: true

write_files:
  - path: /etc/dissect-smoketest/provisioned
    content: |
      template=ubuntu-24.04
      lifecycle=pinned
    permissions: '0644'
